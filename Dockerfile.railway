# Railway deployment Dockerfile for ZeroClaw
# Based on razrinn/zeroclaw-railway-template, adapted for fork-based builds.

# ── Stage 1: Build from fork source ────────────────────────────
FROM rust:1.93-slim AS builder

WORKDIR /src

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy source from fork (not cloned from GitHub)
COPY Cargo.toml Cargo.lock build.rs ./
COPY crates/ crates/
COPY src/ src/
COPY benches/ benches/
COPY firmware/ firmware/
COPY templates/ templates/
COPY web/ web/

# Ensure web/dist exists (required by RustEmbed at compile time)
RUN mkdir -p web/dist && \
    if [ ! -f web/dist/index.html ]; then \
      printf '%s\n' \
        '<!doctype html>' \
        '<html lang="en">' \
        '  <head><meta charset="utf-8" /><title>ZeroClaw</title></head>' \
        '  <body><h1>ZeroClaw Dashboard</h1><p>Frontend assets not bundled.</p></body>' \
        '</html>' > web/dist/index.html; \
    fi

# Build ZeroClaw in release mode
RUN cargo build --release --locked

# Strip binary for smaller size
RUN strip target/release/zeroclaw

# ── Stage 2: Runtime ───────────────────────────────────────────
FROM debian:trixie-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    jq \
    nodejs \
    npm \
    procps \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# agent-browser: headless browser CLI for AI agents
# Chromium is NOT downloaded here — agent-browser install runs at first boot
# onto the persistent /data volume to keep the image lean
RUN npm install -g agent-browser

# Python scraping stack
RUN pip3 install --break-system-packages scrapy requests beautifulsoup4

# Copy ZeroClaw binary from builder
COPY --from=builder /src/target/release/zeroclaw /usr/local/bin/zeroclaw

# Create data directory for persistent storage (Railway volume mount)
RUN mkdir -p /data/.zeroclaw /data/workspace

# Copy startup script
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Set environment - HOME=/data makes ZeroClaw use /data/.zeroclaw
ENV HOME=/data
ENV ZEROCLAW_WORKSPACE=/data/workspace
ENV SHELL=/bin/bash

WORKDIR /data

CMD ["/app/start.sh"]
